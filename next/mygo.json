{
  "name": "Plainmark Go",
  "slug": "plainmark-go",
  "identifier": "com.plainmark.go",
  "version": "0.2.0",
  "main": "./cmd/plainmark",
  "icon": "resources/icon.png",
  "out": "build/release",
  "fileAssociations": [
    { "ext": ["md", "mdx"], "name": "Markdown Note", "mimeType": "text/markdown", "role": "Editor" }
