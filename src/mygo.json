{
  "name": "Plainmark",
  "slug": "plainmark",
  "identifier": "com.plainmark.app",
  "version": "0.2.55",
  "main": "./cmd/plainmark",
  "icon": "resources/icon.png",
  "out": "build/release",
  "fileAssociations": [
    { "ext": ["md", "mdx"], "name": "Markdown Note", "mimeType": "text/markdown", "role": "Editor" }
  ],
  "linux": {
    "webview": false,
    "command": "plainmark"
  },
  "macos": {
    "icon": "resources/icon.icns",
    "minimumSystemVersion": "12.0",
    "signingIdentity": "-",
    "infoPlist": { "CFBundleLocalizations": ["en", "ru"] }
  }
}
